<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>io.homecortex.control</string>
  <key>ProgramArguments</key>
  <array>
    <string>__INSTALL_ROOT__/bin/homecortex-control</string>
    <string>--root</string><string>__INSTALL_ROOT__</string>
  </array>
  <key>WorkingDirectory</key><string>__INSTALL_ROOT__</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>__INSTALL_ROOT__/logs/control.log</string>
  <key>StandardErrorPath</key><string>__INSTALL_ROOT__/logs/control.error.log</string>
</dict>
</plist>

