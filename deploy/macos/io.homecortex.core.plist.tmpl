<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>io.homecortex.core</string>
  <key>ProgramArguments</key>
  <array>
    <string>__PYTHON_BIN__</string>
    <string>__INSTALL_ROOT__/app/server.py</string>
  </array>
  <key>WorkingDirectory</key><string>__INSTALL_ROOT__</string>
  <key>EnvironmentVariables</key>
  <dict><key>HOME_CORTEX_ROOT</key><string>__INSTALL_ROOT__</string></dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>__INSTALL_ROOT__/logs/core.log</string>
  <key>StandardErrorPath</key><string>__INSTALL_ROOT__/logs/core.error.log</string>
</dict>
</plist>
