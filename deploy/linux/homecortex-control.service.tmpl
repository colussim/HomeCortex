[Unit]
Description=HomeCortex Control Plane
After=network-online.target homecortex-core.service

[Service]
Type=simple
User=homecortex
Group=homecortex
WorkingDirectory=__INSTALL_ROOT__
ExecStart=__INSTALL_ROOT__/bin/homecortex-control --root __INSTALL_ROOT__
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target

